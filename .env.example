# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=your_telegram_user_id
MAX_UPLOAD_MB=1900

# ==============================================================================
# Datadog Configuration (Optional)
# ==============================================================================
# The bot will work normally with standard logging if Datadog is not configured
# Choose one of the scenarios below based on your setup:

# ------------------------------------------------------------------------------
# SCENARIO 1: Using Existing Datadog Agent on Server
# ------------------------------------------------------------------------------
# If you already have Datadog agent running on your server, configure these:
# DD_AGENT_HOST=localhost (or the IP/hostname of your Datadog agent)
# DD_AGENT_PORT=8125
# DD_TRACE_AGENT_URL=http://localhost:8126
# DD_SERVICE=vdownloader
# DD_ENV=production
# DD_VERSION=1.0.0

# ------------------------------------------------------------------------------
# SCENARIO 2: Using Bundled Datadog Agent Container
# ------------------------------------------------------------------------------
# If you want to run Datadog agent as a container alongside the bot:
# 1. Uncomment the following variables
# 2. Run: docker-compose -f docker-compose.yml -f docker-compose.datadog.yml up -d

# DD_API_KEY=your_datadog_api_key_here
# DD_SITE=datadoghq.com
# DD_SERVICE=vdownloader
# DD_ENV=production
# DD_VERSION=1.0.0
# DD_AGENT_HOST=datadog-agent
# DD_AGENT_PORT=8125
# DD_TRACE_AGENT_URL=http://datadog-agent:8126

# ------------------------------------------------------------------------------
# SCENARIO 3: No Datadog (Standard Logging Only)
# ------------------------------------------------------------------------------
# Leave all Datadog variables commented out
# The bot will run with standard logging to stdout

